    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^13.17.0",
    "vite": "^6.0.3"
  }
}
