{
  "name": "projetoia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "start": "npm run start --prefix server",
    "test": "npm run test --prefix server",
    "test:unit": "npm run test:unit --prefix server",
    "test:integration": "npm run test:integration --prefix server",
    "test:e2e": "npm run test:e2e --prefix client",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
